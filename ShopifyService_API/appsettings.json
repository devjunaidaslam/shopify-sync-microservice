{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "ShopifyService_API": "Debug"
    }
  },
  "AWS": {
    "Region": "ca-central-1",
    "LogGroup": "ShopifyServiceLogGroup"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=shopify_sync;Username=postgres;Password=YOUR_PASSWORD"
  },
  "Shopify": {
    "Token": "YOUR_SHOPIFY_ADMIN_API_TOKEN",
    "ShopName": "your-shop-name",
    "Version": "2023-04",
    "VariantPageSize": 30,
    "CollectionPageSize": 30,
    "InventoryLevelPageSize": 10,
    "VariantMetaFieldPageSize": 20,
    "ProductPageSize": 50,
    "LocationPageSize": 5,
    "VendorPageSize": 200,
    "ConcurrencyLimit": 3,
    "WebHookSecret": "YOUR_WEBHOOK_SECRET"
  },
  "JwtSettings": {
    "Secret": "YOUR_JWT_SECRET_MIN_32_CHARS",
    "Issuer": "ShopifySyncIssuer",
    "Audience": "ShopifySyncAudience",
    "ExpiryInMinutes": 60
  },
  "AppSettings": {
    "APIRootPath": "http://localhost:5000",
    "AWS_ACCESS_KEY": "YOUR_AWS_ACCESS_KEY",
    "AWS_SECRET_ACCESS_KEY": "YOUR_AWS_SECRET_ACCESS_KEY"
  },
  "Quartz": {
    "ImportShopifyJob": {
      "Enabled": false,
      "Cron": "0 0/10 * * * ?",
      "Date": "2026/01/01"
    }
  },
  "TransactionHistory": {
    "RetentionDays": 30,
    "EnableLogging": true,
    "LogPayload": true,
    "LogResponse": true,
    "MaxPayloadSize": 10000,
    "CleanupSchedule": "0 0 2 * * ?"
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "Port": 5672,
    "UseSsl": false
  },
  "AllowedHosts": "*"
}
